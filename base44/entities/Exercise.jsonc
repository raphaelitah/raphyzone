{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "exercise_code": {
      "type": "string",
      "description": "Source exercise ID (e.g. EX00001)"
    },
    "name": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "movement_category": {
      "type": "string"
    },
    "body_region": {
      "type": "string"
    },
    "movement_pattern": {
      "type": "string"
    },
    "primary_muscle_group": {
      "type": "string"
    },
    "secondary_muscle_group": {
      "type": "string"
    },
    "equipment": {
      "type": "string"
    },
    "modality": {
      "type": "string"
    },
    "laterality": {
      "type": "string"
    },
    "compound_isolation": {
      "type": "string"
    },
    "impact_level": {
      "type": "string"
    },
    "technical_difficulty": {
      "type": "number"
    },
    "physical_demand": {
      "type": "number"
    },
    "requires_load": {
      "type": "boolean"
    },
    "default_prescription_unit": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "submission_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "rejection_reason": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}